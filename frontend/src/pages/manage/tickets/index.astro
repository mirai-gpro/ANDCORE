---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="チケット管理">
  <div id="tickets-loading" class="loading">読み込み中...</div>
  <div id="tickets-content" class="page hidden">
    <a href="/manage" class="back-link">&larr; 運営管理に戻る</a>
    <div class="page-header">
      <h1>チケット管理</h1>
      <p class="subtitle">メンバー・券種ごとの販売状況</p>
    </div>

    <div id="events-list" class="events-list">
      <p class="empty-state">イベントがありません</p>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../../lib/supabase';

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { window.location.href = '/auth/login'; return; }

    const role = user.user_metadata?.role;
    if (role !== 'organizer' && role !== 'admin') {
      window.location.href = '/dashboard';
      return;
    }

    // イベント一覧
    const { data: events } = await supabase
      .from('events')
      .select('id, title, subtitle, status, ticket_price, created_at')
      .eq('organizer_id', user.id)
      .order('created_at', { ascending: false });

    if (!events || events.length === 0) {
      document.getElementById('tickets-loading')!.classList.add('hidden');
      document.getElementById('tickets-content')!.classList.remove('hidden');
      return;
    }

    const eventIds = events.map(e => e.id);

    // 日程取得
    const { data: allDates } = await supabase
      .from('event_dates')
      .select('id, event_id, event_date')
      .in('event_id', eventIds)
      .order('event_date');

    // タイムスロット取得
    const dateIds = (allDates || []).map(d => d.id);
    const { data: allSlots } = dateIds.length > 0
      ? await supabase.from('event_time_slots').select('id, event_date_id, start_time').in('event_date_id', dateIds).order('start_time')
      : { data: [] };

    // スロットメンバー取得
    const slotIds = (allSlots || []).map(s => s.id);
    const { data: allMembers } = slotIds.length > 0
      ? await supabase.from('event_slot_members').select('id, event_time_slot_id, display_name, sort_order').in('event_time_slot_id', slotIds).order('sort_order')
      : { data: [] };

    // チケット商品取得（新構造: event_slot_member_id あり）
    const { data: allProducts } = await supabase
      .from('ticket_products')
      .select('id, event_id, event_slot_member_id, ticket_type, price, stock_limit')
      .in('event_id', eventIds);

    // 販売数取得
    const productIds = (allProducts || []).map(p => p.id);
    let salesMap: Record<string, { valid: number; used: number; total: number }> = {};
    if (productIds.length > 0) {
      const { data: userTickets } = await supabase
        .from('user_tickets')
        .select('ticket_product_id, status')
        .in('ticket_product_id', productIds);

      for (const t of (userTickets || [])) {
        if (!salesMap[t.ticket_product_id]) salesMap[t.ticket_product_id] = { valid: 0, used: 0, total: 0 };
        salesMap[t.ticket_product_id].total++;
        if (t.status === 'valid') salesMap[t.ticket_product_id].valid++;
        if (t.status === 'used') salesMap[t.ticket_product_id].used++;
      }
    }

    // マップ構築
    const dateMap: Record<string, any[]> = {};
    for (const d of (allDates || [])) {
      if (!dateMap[d.event_id]) dateMap[d.event_id] = [];
      dateMap[d.event_id].push(d);
    }

    const slotMap: Record<string, any[]> = {};
    for (const s of (allSlots || [])) {
      if (!slotMap[s.event_date_id]) slotMap[s.event_date_id] = [];
      slotMap[s.event_date_id].push(s);
    }

    const memberMap: Record<string, any[]> = {};
    for (const m of (allMembers || [])) {
      if (!memberMap[m.event_time_slot_id]) memberMap[m.event_time_slot_id] = [];
      memberMap[m.event_time_slot_id].push(m);
    }

    const productByMember: Record<string, any[]> = {};
    for (const p of (allProducts || [])) {
      if (p.event_slot_member_id) {
        if (!productByMember[p.event_slot_member_id]) productByMember[p.event_slot_member_id] = [];
        productByMember[p.event_slot_member_id].push(p);
      }
    }

    const statusLabels: Record<string, string> = { scheduled: '開催前', active: '開催中', completed: '開催済', cancelled: 'キャンセル' };
    const statusClasses: Record<string, string> = { scheduled: 'badge-scheduled', active: 'badge-active', completed: 'badge-completed', cancelled: 'badge-cancelled' };

    function formatDate(dateStr: string) {
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('ja-JP', { month: 'short', day: 'numeric', weekday: 'short' });
    }

    const container = document.getElementById('events-list')!;
    container.innerHTML = events.map(event => {
      const dates = dateMap[event.id] || [];
      const priceDisplay = event.ticket_price == null ? '無料' : `¥${event.ticket_price.toLocaleString()}`;

      // メンバー×券種の販売テーブルを構築
      let salesHtml = '';
      if (dates.length > 0) {
        let hasAnyProducts = false;

        salesHtml += '<div class="sales-detail">';
        for (const date of dates) {
          const slots = slotMap[date.id] || [];
          for (const slot of slots) {
            const members = memberMap[slot.id] || [];
            if (members.length === 0) continue;
            hasAnyProducts = true;

            salesHtml += `<div class="slot-block">`;
            salesHtml += `<div class="slot-block-header">${formatDate(date.event_date)} ${slot.start_time.slice(0, 5)}</div>`;
            salesHtml += `<table class="sales-table"><thead><tr><th>メンバー</th><th>券種</th><th>価格</th><th>販売</th><th>上限</th><th>未使用</th><th>使用済</th></tr></thead><tbody>`;

            for (const member of members) {
              const products = productByMember[member.id] || [];
              if (products.length === 0) {
                salesHtml += `<tr><td class="member-name">${member.display_name}</td><td colspan="6" class="no-data">券種未設定</td></tr>`;
                continue;
              }
              for (let pi = 0; pi < products.length; pi++) {
                const p = products[pi];
                const s = salesMap[p.id] || { valid: 0, used: 0, total: 0 };
                const stockStr = p.stock_limit != null ? String(p.stock_limit) : '-';
                const soldRatio = p.stock_limit != null && p.stock_limit > 0 ? Math.round(s.total / p.stock_limit * 100) : null;
                const soldClass = soldRatio !== null && soldRatio >= 80 ? 'hot' : '';
                salesHtml += `<tr>
                  ${pi === 0 ? `<td class="member-name" rowspan="${products.length}">${member.display_name}</td>` : ''}
                  <td>${p.ticket_type}</td>
                  <td class="price">¥${p.price.toLocaleString()}</td>
                  <td class="sold ${soldClass}">${s.total}枚${soldRatio !== null ? ` (${soldRatio}%)` : ''}</td>
                  <td>${stockStr}</td>
                  <td>${s.valid}</td>
                  <td>${s.used}</td>
                </tr>`;
              }
            }
            salesHtml += `</tbody></table></div>`;
          }
        }

        if (!hasAnyProducts) {
          salesHtml = '<p class="no-products">メンバー・券種が未設定です</p>';
        } else {
          salesHtml += '</div>';
        }
      } else {
        salesHtml = '<p class="no-products">日程が未設定です</p>';
      }

      return `
        <div class="event-card">
          <div class="event-header">
            <div class="event-info">
              <h3>${event.title}</h3>
              ${event.subtitle ? `<p class="event-subtitle">${event.subtitle}</p>` : ''}
              <p class="event-date">${dates.map(d => formatDate(d.event_date)).join(', ') || '日程未設定'}</p>
            </div>
            <div class="event-header-right">
              <span class="badge ${statusClasses[event.status] || ''}">${statusLabels[event.status] || event.status}</span>
              <span class="entry-price">${priceDisplay}</span>
            </div>
          </div>
          ${salesHtml}
        </div>
      `;
    }).join('');

    document.getElementById('tickets-loading')!.classList.add('hidden');
    document.getElementById('tickets-content')!.classList.remove('hidden');
  }

  init();
</script>

<style>
  .loading { text-align: center; padding: 3rem; color: var(--color-text-muted); }
  .hidden { display: none; }
  .page { max-width: 900px; margin: 0 auto; }
  .back-link { font-size: 0.8rem; color: var(--color-text-muted); display: inline-block; margin-bottom: 0.5rem; }
  .back-link:hover { color: var(--color-primary); }
  .page-header { margin-bottom: 2rem; }
  .page-header h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .subtitle { color: var(--color-text-muted); font-size: 0.9rem; }
  .events-list { display: flex; flex-direction: column; gap: 1.25rem; }

  .event-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
  }

  .event-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--color-border);
  }
  .event-info h3 { font-size: 1rem; margin-bottom: 0.125rem; }
  .event-subtitle { font-size: 0.8rem; color: var(--color-text-muted); }
  .event-date { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.25rem; }
  .event-header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.375rem; }
  .entry-price { font-size: 0.8rem; color: var(--color-primary); font-weight: 600; }

  .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 600; }
  .badge-scheduled { background: #dbeafe; color: #1d4ed8; }
  .badge-active { background: #dcfce7; color: #16a34a; }
  .badge-completed { background: #f3f4f6; color: #6b7280; }
  .badge-cancelled { background: #fef2f2; color: #dc2626; }

  /* Sales detail */
  .sales-detail { display: flex; flex-direction: column; gap: 0.75rem; }

  .slot-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .slot-block-header {
    background: #f3f4f6; padding: 0.5rem 0.75rem;
    font-size: 0.8rem; font-weight: 600; color: #374151;
  }

  .sales-table {
    width: 100%; border-collapse: collapse; font-size: 0.78rem;
  }
  .sales-table th {
    background: #f9fafb; padding: 0.4rem 0.5rem;
    text-align: left; font-weight: 600; color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border); font-size: 0.72rem;
    white-space: nowrap;
  }
  .sales-table td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid #f3f4f6;
    vertical-align: middle;
  }
  .sales-table tr:last-child td { border-bottom: none; }

  .member-name { font-weight: 600; white-space: nowrap; }
  .price { color: var(--color-primary); font-weight: 600; white-space: nowrap; }
  .sold { font-weight: 600; white-space: nowrap; }
  .sold.hot { color: #dc2626; }
  .no-data { color: var(--color-text-muted); font-style: italic; }
  .no-products { font-size: 0.8rem; color: var(--color-text-muted); padding: 0.5rem 0; }

  .empty-state { text-align: center; color: var(--color-text-muted); font-size: 0.85rem; padding: 3rem; }

  @media (max-width: 640px) {
    .sales-table { font-size: 0.7rem; }
    .sales-table th, .sales-table td { padding: 0.3rem 0.35rem; }
    .event-header { flex-direction: column; gap: 0.5rem; }
    .event-header-right { flex-direction: row; align-items: center; }
  }
</style>
