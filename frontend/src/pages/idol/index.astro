---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="アイドルポータル">
  <div id="idol-loading" class="loading">読み込み中...</div>
  <div id="idol-content" class="portal hidden">

    <div class="page-header">
      <div class="header-row">
        <div>
          <h1 id="idol-name">マイポータル</h1>
          <p class="subtitle">ファンコミュニティの管理</p>
        </div>
        <span class="badge-idol">IDOL</span>
      </div>
    </div>

    <!-- 概要統計 -->
    <div class="stats-grid">
      <div class="stat-card accent">
        <p class="stat-label">推し登録ファン数</p>
        <p class="stat-value" id="follower-count">0</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">今月の撮影回数</p>
        <p class="stat-value" id="photo-count">0</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">未読メッセージ</p>
        <p class="stat-value" id="unread-count">0</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">次回イベント</p>
        <p class="stat-value stat-text" id="next-event">-</p>
      </div>
    </div>

    <!-- ファンランキング -->
    <section class="section">
      <div class="section-header">
        <h2>ファンランキング</h2>
        <span class="section-hint">エンゲージメントスコア順</span>
      </div>
      <div class="ranking-list" id="ranking-list">
        <p class="empty-state">データを取得中...</p>
      </div>
    </section>

    <!-- チケット販売状況 -->
    <section class="section">
      <div class="section-header">
        <h2>チケット販売状況</h2>
        <span class="section-hint">出演イベントの全メンバー分</span>
      </div>
      <div id="ticket-sales" class="ticket-sales">
        <p class="empty-state">読み込み中...</p>
      </div>
    </section>

    <!-- メニュー -->
    <section class="section">
      <h2>コミュニティ管理</h2>
      <div class="menu-grid">
        <a href="/idol/announcements" class="menu-card">
          <div class="menu-icon">📢</div>
          <h3>お知らせ投稿</h3>
          <p>ファンへの告知・近況報告を投稿</p>
        </a>
        <a href="/idol/messages" class="menu-card">
          <div class="menu-icon">💬</div>
          <h3>メッセージ</h3>
          <p>ファンとの1:1コミュニケーション</p>
        </a>
        <a href="/idol/fans" class="menu-card">
          <div class="menu-icon">👥</div>
          <h3>ファン一覧</h3>
          <p>推し登録ファンの確認・動向分析</p>
        </a>
        <a href="/idol/media" class="menu-card">
          <div class="menu-icon">📸</div>
          <h3>撮影ギャラリー</h3>
          <p>過去の撮影データを閲覧・管理</p>
        </a>
      </div>
    </section>

    <!-- 最近のファン動向 -->
    <section class="section">
      <h2>最近のファン動向</h2>
      <div class="activity-feed" id="activity-feed">
        <p class="empty-state">まだアクティビティがありません</p>
      </div>
    </section>

    <button id="logout-btn" class="btn-logout">ログアウト</button>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      window.location.href = '/auth/login';
      return;
    }

    const role = user.user_metadata?.role;
    if (role !== 'idol' && role !== 'admin') {
      window.location.href = '/dashboard';
      return;
    }

    const idolName = user.user_metadata?.nickname || user.user_metadata?.full_name || 'マイポータル';
    document.getElementById('idol-name')!.textContent = `${idolName}のポータル`;

    // 統計を並行取得
    const [followersRes, photosRes, unreadRes, nextEventRes] = await Promise.all([
      supabase
        .from('fan_follows')
        .select('*', { count: 'exact', head: true })
        .eq('idol_id', user.id),
      supabase
        .from('media_assets')
        .select('*', { count: 'exact', head: true })
        .eq('idol_id', user.id),
      supabase
        .from('fan_messages')
        .select('*', { count: 'exact', head: true })
        .eq('receiver_id', user.id)
        .is('read_at', null),
      supabase
        .from('ticket_products')
        .select('events(title, event_date)')
        .eq('idol_id', user.id)
        .gt('events.event_date', new Date().toISOString())
        .order('created_at', { ascending: true })
        .limit(1),
    ]);

    document.getElementById('follower-count')!.textContent = String(followersRes.count ?? 0);
    document.getElementById('photo-count')!.textContent = String(photosRes.count ?? 0);
    document.getElementById('unread-count')!.textContent = String(unreadRes.count ?? 0);

    if (nextEventRes.data && nextEventRes.data.length > 0) {
      const event = (nextEventRes.data[0] as any).events;
      if (event) {
        const date = new Date(event.event_date).toLocaleDateString('ja-JP', { month: 'short', day: 'numeric' });
        document.getElementById('next-event')!.textContent = `${date} ${event.title}`;
      }
    }

    // ファンランキング取得
    const { data: rankings } = await supabase
      .from('fan_engagement')
      .select('fan_id, engagement_score, total_points_spent, event_count, photo_count')
      .eq('idol_id', user.id)
      .order('engagement_score', { ascending: false })
      .limit(10);

    const rankingList = document.getElementById('ranking-list')!;

    if (rankings && rankings.length > 0) {
      // ファンのプロフィールを取得
      const fanIds = rankings.map(r => r.fan_id);
      const { data: fans } = await supabase
        .from('profiles')
        .select('id, nickname, avatar_url')
        .in('id', fanIds);

      const fanMap = new Map((fans ?? []).map(f => [f.id, f]));

      rankingList.innerHTML = rankings.map((r, i) => {
        const fan = fanMap.get(r.fan_id);
        const name = fan?.nickname ?? '匿名ファン';
        const rankIcon = i === 0 ? '👑' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}`;
        return `
          <div class="ranking-item">
            <span class="rank">${rankIcon}</span>
            <div class="ranking-info">
              <span class="fan-name">${name}</span>
              <span class="fan-stats">${r.event_count}回参加 / ${r.photo_count}枚撮影</span>
            </div>
            <span class="score">${r.engagement_score} pt</span>
          </div>
        `;
      }).join('');
    } else {
      rankingList.innerHTML = '<p class="empty-state">まだランキングデータがありません</p>';
    }

    // === チケット販売状況を取得 ===
    await loadTicketSales(user.id);

    document.getElementById('idol-loading')!.classList.add('hidden');
    document.getElementById('idol-content')!.classList.remove('hidden');
  }

  async function loadTicketSales(userId: string) {
    const salesContainer = document.getElementById('ticket-sales')!;

    // このユーザーのidol_memberレコードを取得（profile_id一致）
    const { data: myIdolMembers } = await supabase
      .from('idol_members')
      .select('id, group_id')
      .eq('profile_id', userId);

    // idol_membersにprofile_idが紐づいてない場合、event_slot_membersのidol_idで検索
    const { data: mySlotMembers } = await supabase
      .from('event_slot_members')
      .select('id, event_time_slot_id')
      .eq('idol_id', userId);

    // 自分が出演するスロットIDを集める
    let mySlotIds: string[] = [];
    if (mySlotMembers && mySlotMembers.length > 0) {
      mySlotIds = mySlotMembers.map(m => m.event_time_slot_id);
    } else if (myIdolMembers && myIdolMembers.length > 0) {
      // idol_membersのidでevent_slot_membersを検索
      const idolMemberIds = myIdolMembers.map(m => m.id);
      // event_slot_membersのidol_idはprofiles.idを参照するので、
      // idol_members.idではなくprofile_idで既に検索済み。
      // 別の方法: display_nameで検索（フォールバック）
    }

    if (mySlotIds.length === 0) {
      // 直接profile_idでも検索してみる
      const { data: slotsByProfile } = await supabase
        .from('event_slot_members')
        .select('event_time_slot_id')
        .eq('idol_id', userId);

      if (slotsByProfile && slotsByProfile.length > 0) {
        mySlotIds = slotsByProfile.map(m => m.event_time_slot_id);
      }
    }

    if (mySlotIds.length === 0) {
      salesContainer.innerHTML = '<p class="empty-state">出演イベントがありません</p>';
      return;
    }

    // スロット→日程→イベントを逆引き
    const { data: slots } = await supabase
      .from('event_time_slots')
      .select('id, start_time, event_date_id, event_dates(id, event_date, event_id, events(id, title))')
      .in('id', mySlotIds);

    if (!slots || slots.length === 0) {
      salesContainer.innerHTML = '<p class="empty-state">出演イベントがありません</p>';
      return;
    }

    // イベントIDを収集
    const eventIds = new Set<string>();
    for (const s of slots) {
      const ed = s.event_dates as any;
      if (ed?.events?.id) eventIds.add(ed.events.id);
    }

    if (eventIds.size === 0) {
      salesContainer.innerHTML = '<p class="empty-state">出演イベントがありません</p>';
      return;
    }

    // そのイベントの全日程・全スロット・全メンバーを取得（自分だけでなく全員）
    const { data: allDates } = await supabase
      .from('event_dates')
      .select('id, event_id, event_date')
      .in('event_id', Array.from(eventIds))
      .order('event_date');

    const allDateIds = (allDates || []).map(d => d.id);
    const { data: allSlots } = allDateIds.length > 0
      ? await supabase.from('event_time_slots').select('id, event_date_id, start_time').in('event_date_id', allDateIds).order('start_time')
      : { data: [] };

    const allSlotIds = (allSlots || []).map(s => s.id);
    const { data: allMembers } = allSlotIds.length > 0
      ? await supabase.from('event_slot_members').select('id, event_time_slot_id, display_name, idol_id, sort_order').in('event_time_slot_id', allSlotIds).order('sort_order')
      : { data: [] };

    // チケット商品
    const { data: allProducts } = await supabase
      .from('ticket_products')
      .select('id, event_id, event_slot_member_id, ticket_type, price, stock_limit')
      .in('event_id', Array.from(eventIds));

    // 販売数
    const productIds = (allProducts || []).map(p => p.id);
    let salesMap: Record<string, { valid: number; used: number; total: number }> = {};
    if (productIds.length > 0) {
      const { data: userTickets } = await supabase
        .from('user_tickets')
        .select('ticket_product_id, status')
        .in('ticket_product_id', productIds);
      for (const t of (userTickets || [])) {
        if (!salesMap[t.ticket_product_id]) salesMap[t.ticket_product_id] = { valid: 0, used: 0, total: 0 };
        salesMap[t.ticket_product_id].total++;
        if (t.status === 'valid') salesMap[t.ticket_product_id].valid++;
        if (t.status === 'used') salesMap[t.ticket_product_id].used++;
      }
    }

    // マップ構築
    const datesByEvent: Record<string, any[]> = {};
    for (const d of (allDates || [])) {
      if (!datesByEvent[d.event_id]) datesByEvent[d.event_id] = [];
      datesByEvent[d.event_id].push(d);
    }
    const slotsByDate: Record<string, any[]> = {};
    for (const s of (allSlots || [])) {
      if (!slotsByDate[s.event_date_id]) slotsByDate[s.event_date_id] = [];
      slotsByDate[s.event_date_id].push(s);
    }
    const membersBySlot: Record<string, any[]> = {};
    for (const m of (allMembers || [])) {
      if (!membersBySlot[m.event_time_slot_id]) membersBySlot[m.event_time_slot_id] = [];
      membersBySlot[m.event_time_slot_id].push(m);
    }
    const productsByMember: Record<string, any[]> = {};
    for (const p of (allProducts || [])) {
      if (p.event_slot_member_id) {
        if (!productsByMember[p.event_slot_member_id]) productsByMember[p.event_slot_member_id] = [];
        productsByMember[p.event_slot_member_id].push(p);
      }
    }

    // イベント名マップ
    const eventNameMap: Record<string, string> = {};
    for (const s of slots) {
      const ed = s.event_dates as any;
      if (ed?.events) eventNameMap[ed.events.id] = ed.events.title;
    }

    function formatDate(dateStr: string) {
      return new Date(dateStr + 'T00:00:00').toLocaleDateString('ja-JP', { month: 'short', day: 'numeric', weekday: 'short' });
    }

    // HTML生成
    let html = '';
    for (const eventId of eventIds) {
      const dates = datesByEvent[eventId] || [];
      html += `<div class="sales-event">`;
      html += `<div class="sales-event-title">${eventNameMap[eventId] || 'イベント'}</div>`;

      for (const date of dates) {
        const slotsForDate = slotsByDate[date.id] || [];
        for (const slot of slotsForDate) {
          const members = membersBySlot[slot.id] || [];
          if (members.length === 0) continue;

          html += `<div class="sales-slot-header">${formatDate(date.event_date)} ${slot.start_time.slice(0, 5)}</div>`;
          html += `<table class="sales-table"><thead><tr><th>メンバー</th><th>券種</th><th>価格</th><th>販売</th><th>上限</th></tr></thead><tbody>`;

          for (const member of members) {
            const isMe = member.idol_id === userId;
            const products = productsByMember[member.id] || [];
            const rowClass = isMe ? 'me-row' : '';

            if (products.length === 0) {
              html += `<tr class="${rowClass}"><td class="member-name">${member.display_name}${isMe ? ' <span class="me-badge">自分</span>' : ''}</td><td colspan="4" class="no-data">券種未設定</td></tr>`;
              continue;
            }
            for (let pi = 0; pi < products.length; pi++) {
              const p = products[pi];
              const s = salesMap[p.id] || { valid: 0, used: 0, total: 0 };
              const stockStr = p.stock_limit != null ? String(p.stock_limit) : '-';
              html += `<tr class="${rowClass}">
                ${pi === 0 ? `<td class="member-name" rowspan="${products.length}">${member.display_name}${isMe ? ' <span class="me-badge">自分</span>' : ''}</td>` : ''}
                <td>${p.ticket_type}</td>
                <td class="price">¥${p.price.toLocaleString()}</td>
                <td class="sold">${s.total}枚</td>
                <td>${stockStr}</td>
              </tr>`;
            }
          }
          html += `</tbody></table>`;
        }
      }
      html += `</div>`;
    }

    salesContainer.innerHTML = html || '<p class="empty-state">出演イベントがありません</p>';
  }

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  init();
</script>

<style>
  .loading {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
  }

  .hidden { display: none; }

  .page-header { margin-bottom: 2rem; }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .page-header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .badge-idol {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: linear-gradient(135deg, #ec4899, #a855f7);
    color: white;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
  }

  .stat-card.accent {
    border-color: #ec4899;
    background: linear-gradient(135deg, #fdf2f8, #faf5ff);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .stat-text {
    font-size: 0.9rem;
  }

  /* Sections */
  .section {
    margin-bottom: 2rem;
  }

  .section h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .section-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Ranking */
  .ranking-list {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .ranking-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .ranking-item:last-child {
    border-bottom: none;
  }

  .rank {
    font-size: 1.1rem;
    font-weight: 700;
    min-width: 2rem;
    text-align: center;
  }

  .ranking-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .fan-name {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .fan-stats {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .score {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  /* Menu */
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .menu-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
    transition: border-color 0.2s, box-shadow 0.2s;
    color: var(--color-text);
    text-decoration: none;
  }

  .menu-card:hover {
    border-color: #ec4899;
    box-shadow: 0 2px 8px rgba(236, 72, 153, 0.15);
    color: var(--color-text);
  }

  .menu-icon {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .menu-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .menu-card p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Activity */
  .activity-feed {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    padding: 1rem;
  }

  /* Ticket Sales */
  .ticket-sales {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sales-event {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .sales-event-title {
    padding: 0.75rem 1rem;
    font-weight: 700;
    font-size: 0.9rem;
    background: linear-gradient(135deg, #fdf2f8, #faf5ff);
    border-bottom: 1px solid var(--color-border);
  }

  .sales-slot-header {
    padding: 0.4rem 0.75rem;
    background: #f3f4f6;
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
  }

  .sales-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .sales-table th {
    background: #f9fafb;
    padding: 0.35rem 0.5rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .sales-table td {
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid #f3f4f6;
    vertical-align: middle;
  }

  .sales-table tr:last-child td { border-bottom: none; }

  .sales-table .member-name { font-weight: 600; white-space: nowrap; }
  .sales-table .price { color: var(--color-primary); font-weight: 600; }
  .sales-table .sold { font-weight: 600; }
  .sales-table .no-data { color: var(--color-text-muted); font-style: italic; }

  .me-row { background: #fdf2f8; }
  .me-badge {
    display: inline-block;
    background: linear-gradient(135deg, #ec4899, #a855f7);
    color: white;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 9999px;
    vertical-align: middle;
    margin-left: 0.25rem;
  }

  @media (max-width: 640px) {
    .sales-table { font-size: 0.7rem; }
    .sales-table th, .sales-table td { padding: 0.25rem 0.3rem; }
  }

  .btn-logout {
    margin-top: 2rem;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-text);
  }
  .btn-logout:hover { border-color: #dc2626; color: #dc2626; }
</style>
