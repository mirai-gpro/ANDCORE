---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="イベント一覧">
  <div class="events-header">
    <h1>イベント一覧</h1>
    <p>開催中・予定のイベントを確認できます</p>
  </div>

  <div id="events-list" class="events-grid">
    <p class="loading">イベント読み込み中...</p>
  </div>

  <div id="no-events" class="empty-state hidden">
    <p>現在予定されているイベントはありません</p>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function loadEvents() {
    const listEl = document.getElementById('events-list')!;
    const emptyEl = document.getElementById('no-events')!;

    // event_dates を結合して日程を取得
    const { data: events, error } = await supabase
      .from('events')
      .select('*, event_dates(event_date)')
      .in('status', ['scheduled', 'active'])
      .order('created_at', { ascending: false });

    if (error) {
      listEl.innerHTML = `<p class="error">イベントの取得に失敗しました: ${error.message}</p>`;
      return;
    }

    if (!events || events.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    // event_dates から最も早い日程を取得してソート
    const eventsWithDates = events.map(event => {
      const dates = (event.event_dates as any[]) || [];
      const sortedDates = dates
        .map(d => d.event_date)
        .filter(Boolean)
        .sort();
      return { ...event, firstDate: sortedDates[0] || null, allDates: sortedDates };
    });
    eventsWithDates.sort((a, b) => {
      if (!a.firstDate && !b.firstDate) return 0;
      if (!a.firstDate) return 1;
      if (!b.firstDate) return -1;
      return a.firstDate.localeCompare(b.firstDate);
    });

    listEl.innerHTML = eventsWithDates.map(event => {
      const dateDisplay = event.allDates.length > 0
        ? event.allDates.map(d => new Date(d).toLocaleDateString('ja-JP', {
            year: 'numeric', month: 'long', day: 'numeric'
          })).join('、')
        : '日程未定';

      return `
      <a href="/events/${event.id}/tickets" class="event-card-link">
        <div class="event-card">
          <div class="event-status status-${event.status}">
            ${event.status === 'active' ? '開催中' : '予定'}
          </div>
          <h3>${event.title}</h3>
          <p class="event-meta">${dateDisplay}</p>
          <p class="event-location">${event.venue_name || '会場未定'}</p>
          ${event.description ? `<p class="event-desc">${event.description}</p>` : ''}
        </div>
      </a>`;
    }).join('');
  }

  loadEvents();
</script>

<style>
  .events-header {
    margin-bottom: 2rem;
  }

  .events-header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .events-header p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .loading {
    color: var(--color-text-muted);
  }

  .hidden {
    display: none;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
  }

  .error {
    color: #dc2626;
  }
</style>

<style is:global>
  .event-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .event-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
    position: relative;
    transition: border-color 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }

  .event-card:hover {
    border-color: var(--color-primary, #6366f1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .event-status {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .status-active {
    background: #dcfce7;
    color: #16a34a;
  }

  .status-scheduled {
    background: #dbeafe;
    color: #2563eb;
  }

  .event-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .event-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .event-location {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .event-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }
</style>
