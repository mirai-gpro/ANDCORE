---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="イベント一覧">
  <div class="events-header">
    <h1>イベント一覧</h1>
    <p>開催中・予定のイベントを確認できます</p>
  </div>

  <div id="events-list" class="events-list">
    <p class="loading">イベント読み込み中...</p>
  </div>

  <div id="no-events" class="empty-state hidden">
    <p>現在予定されているイベントはありません</p>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function loadEvents() {
    const listEl = document.getElementById('events-list')!;
    const emptyEl = document.getElementById('no-events')!;

    // event_dates を結合して日程と販売期間を取得
    const { data: events, error } = await supabase
      .from('events')
      .select('*, event_dates(event_date, sale_start_at, sale_end_at)')
      .in('status', ['scheduled', 'active'])
      .order('created_at', { ascending: false });

    if (error) {
      listEl.innerHTML = `<p class="error">イベントの取得に失敗しました: ${error.message}</p>`;
      return;
    }

    if (!events || events.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    // event_dates から最も早い日程を取得してソート、販売期間も集約
    const now = new Date();
    const eventsWithDates = events.map(event => {
      const dates = (event.event_dates as any[]) || [];
      const sortedDates = dates
        .map(d => d.event_date)
        .filter(Boolean)
        .sort();

      // 販売ステータスを判定（全日程の中で最も有利な状態を表示）
      let saleStatus: 'none' | 'before' | 'on_sale' | 'ended' = 'none';
      let earliestSaleStart: string | null = null;
      let latestSaleEnd: string | null = null;

      for (const d of dates) {
        if (d.sale_start_at) {
          if (!earliestSaleStart || d.sale_start_at < earliestSaleStart) earliestSaleStart = d.sale_start_at;
        }
        if (d.sale_end_at) {
          if (!latestSaleEnd || d.sale_end_at > latestSaleEnd) latestSaleEnd = d.sale_end_at;
        }
      }

      // 販売期間が設定されている日程があるか
      const hasSalePeriod = dates.some((d: any) => d.sale_start_at || d.sale_end_at);
      if (hasSalePeriod) {
        // いずれかの日程が販売中ならon_sale
        const anyOnSale = dates.some((d: any) => {
          const start = d.sale_start_at ? new Date(d.sale_start_at) : null;
          const end = d.sale_end_at ? new Date(d.sale_end_at) : null;
          const afterStart = !start || start <= now;
          const beforeEnd = !end || now <= end;
          return afterStart && beforeEnd;
        });
        if (anyOnSale) {
          saleStatus = 'on_sale';
        } else if (earliestSaleStart && new Date(earliestSaleStart) > now) {
          saleStatus = 'before';
        } else {
          saleStatus = 'ended';
        }
      }

      return { ...event, firstDate: sortedDates[0] || null, allDates: sortedDates, saleStatus, earliestSaleStart, latestSaleEnd };
    });
    eventsWithDates.sort((a, b) => {
      if (!a.firstDate && !b.firstDate) return 0;
      if (!a.firstDate) return 1;
      if (!b.firstDate) return -1;
      return a.firstDate.localeCompare(b.firstDate);
    });

    const formatDateTime = (iso: string) => {
      const d = new Date(iso);
      return d.toLocaleDateString('ja-JP', { month: 'short', day: 'numeric' }) + ' ' +
        d.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
    };

    listEl.innerHTML = eventsWithDates.map(event => {
      const dateDisplay = event.allDates.length > 0
        ? event.allDates.map(d => new Date(d).toLocaleDateString('ja-JP', {
            year: 'numeric', month: 'long', day: 'numeric'
          })).join('、')
        : '日程未定';

      // 販売ステータスバッジ
      let saleBadge = '';
      let saleInfo = '';
      if (event.saleStatus === 'on_sale') {
        saleBadge = '<span class="sale-badge sale-on">販売中</span>';
        if (event.latestSaleEnd) {
          saleInfo = `<span class="sale-period">〜${formatDateTime(event.latestSaleEnd)}</span>`;
        }
      } else if (event.saleStatus === 'before') {
        saleBadge = '<span class="sale-badge sale-before">販売前</span>';
        if (event.earliestSaleStart) {
          saleInfo = `<span class="sale-period">${formatDateTime(event.earliestSaleStart)}〜</span>`;
        }
      } else if (event.saleStatus === 'ended') {
        saleBadge = '<span class="sale-badge sale-ended">販売終了</span>';
      }

      return `
      <a href="/events/${event.id}/tickets" class="event-row">
        <div class="event-row-left">
          <span class="event-row-title">${event.title}</span>
          ${saleBadge || saleInfo ? `<div class="event-row-sale">${saleBadge}${saleInfo}</div>` : ''}
        </div>
        <span class="event-row-date">${dateDisplay}</span>
      </a>`;
    }).join('');
  }

  loadEvents();
</script>

<style>
  .events-header {
    margin-bottom: 2rem;
  }

  .events-header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .events-header p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .events-list {
    display: flex;
    flex-direction: column;
  }

  .loading {
    color: var(--color-text-muted);
  }

  .hidden {
    display: none;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
  }

  .error {
    color: #dc2626;
  }
</style>

<style is:global>
  .event-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.15s;
  }

  .event-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .event-row:hover {
    background-color: var(--color-surface-hover, rgba(0, 0, 0, 0.02));
  }

  .event-row-left {
    flex-shrink: 1;
    min-width: 0;
    margin-right: 1rem;
  }

  .event-row-title {
    font-size: 0.95rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
  }

  .event-row-sale {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .sale-badge {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .sale-on { background: #dcfce7; color: #16a34a; }
  .sale-before { background: #dbeafe; color: #2563eb; }
  .sale-ended { background: #f3f4f6; color: #6b7280; }

  .sale-period {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .event-row-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
