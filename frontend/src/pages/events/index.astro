---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="イベント一覧">
  <div class="events-header">
    <h1>イベント一覧</h1>
    <p>開催中・予定のイベントを確認できます</p>
  </div>

  <div id="events-list" class="events-list">
    <p class="loading">イベント読み込み中...</p>
  </div>

  <div id="no-events" class="empty-state hidden">
    <p>現在予定されているイベントはありません</p>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function loadEvents() {
    const listEl = document.getElementById('events-list')!;
    const emptyEl = document.getElementById('no-events')!;

    // event_dates を結合して日程を取得
    const { data: events, error } = await supabase
      .from('events')
      .select('*, event_dates(event_date)')
      .in('status', ['scheduled', 'active'])
      .order('created_at', { ascending: false });

    if (error) {
      listEl.innerHTML = `<p class="error">イベントの取得に失敗しました: ${error.message}</p>`;
      return;
    }

    if (!events || events.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    // event_dates から最も早い日程を取得してソート
    const eventsWithDates = events.map(event => {
      const dates = (event.event_dates as any[]) || [];
      const sortedDates = dates
        .map(d => d.event_date)
        .filter(Boolean)
        .sort();
      return { ...event, firstDate: sortedDates[0] || null, allDates: sortedDates };
    });
    eventsWithDates.sort((a, b) => {
      if (!a.firstDate && !b.firstDate) return 0;
      if (!a.firstDate) return 1;
      if (!b.firstDate) return -1;
      return a.firstDate.localeCompare(b.firstDate);
    });

    listEl.innerHTML = eventsWithDates.map(event => {
      const dateDisplay = event.allDates.length > 0
        ? event.allDates.map(d => new Date(d).toLocaleDateString('ja-JP', {
            year: 'numeric', month: 'long', day: 'numeric'
          })).join('、')
        : '日程未定';

      return `
      <a href="/events/${event.id}/tickets" class="event-row">
        <span class="event-row-title">${event.title}</span>
        <span class="event-row-date">${dateDisplay}</span>
      </a>`;
    }).join('');
  }

  loadEvents();
</script>

<style>
  .events-header {
    margin-bottom: 2rem;
  }

  .events-header h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .events-header p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .events-list {
    display: flex;
    flex-direction: column;
  }

  .loading {
    color: var(--color-text-muted);
  }

  .hidden {
    display: none;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
  }

  .error {
    color: #dc2626;
  }
</style>

<style is:global>
  .event-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1rem;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.15s;
  }

  .event-row:first-child {
    border-top: 1px solid var(--color-border);
  }

  .event-row:hover {
    background-color: var(--color-surface-hover, rgba(0, 0, 0, 0.02));
  }

  .event-row-title {
    font-size: 0.95rem;
    font-weight: 500;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 1rem;
  }

  .event-row-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
